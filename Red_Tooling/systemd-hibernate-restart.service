[Unit]
Description=Restart Stale Hibernate Storage Info
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/bash </path/to/script.sh>
Restart=always
RestartSec=3
User=<your_user>

[Install]
WantedBy=multi-user.target